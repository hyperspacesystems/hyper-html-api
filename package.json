{
  "name": "hyper-html-api",
  "description": "self-describing data layer for HTML files — extract, apply, CMS, upgrade",
  "keywords": [
    "HTML",
    "DOM",
    "data",
    "extract",
    "apply",
    "CMS"
  ],
  "version": "0.16.0",
  "homepage": "https://github.com/panphora/hyper-html-api",
  "bugs": {
    "url": "https://github.com/panphora/hyper-html-api/issues"
  },
  "license": "MIT-0",
  "files": [
    "packed-contract.json",
    "LICENSE",
    "README.md",
    "src/**/*.js",
    "dist/*.js",
    "conformance/**"
  ],
  "main": "src/hyper-html-api.js",
  "module": "src/hyper-html-api.js",
  "type": "module",
  "exports": {
    ".": "./src/hyper-html-api.js",
    "./engine": "./src/engine/index.js",
    "./cms": "./src/cms/index.js",
    "./cheerio": "./src/adapters/cheerio.js",
    "./dom": "./src/adapters/dom.js",
    "./data": "./src/data.js",
    "./upgrade": "./src/upgrade.js",
    "./page": "./src/page.js",
    "./write": "./src/write.js",
    "./site": "./src/site.js",
    "./codecs/sheet": "./src/codecs/sheet.js",
    "./read": "./src/read.js"
  },
  "scripts": {
    "build": "npx esbuild src/hyper-html-api.js --bundle --minify --format=iife --global-name=HyperHtmlApi --outfile=dist/hyper-html-api.min.js && npm run build:engine && npm run build:engine:esm",
    "build:engine": "npx esbuild src/data.js --bundle --minify --format=iife --global-name=hyperHtmlApiData --outfile=dist/hyper-html-api.engine.min.js",
    "build:engine:esm": "npx esbuild src/data.js --bundle --minify --format=esm --outfile=dist/hyper-html-api.engine.esm.js",
    "build:upgrade": "npx esbuild src/upgrade.js --bundle --minify --format=iife --global-name=hyperHtmlApiUpgrade --outfile=dist/hyper-html-api.upgrade.min.js",
    "copy-to-hyperclayjs": "npm run build:engine && npm run build:upgrade && node scripts/copy-to-hyperclayjs.js",
    "copy-to-clayjs": "npm run build:engine && npm run build:engine:esm && node scripts/copy-to-clayjs.js",
    "prepublishOnly": "npm run build && npm run build:upgrade",
    "demo": "http-server . -p 5693 -c-1 -o /demo/",
    "test": "web-test-runner",
    "test:debug": "web-test-runner --manual --open",
    "test:chrome": "web-test-runner --playwright --browsers chromium",
    "test:firefox": "web-test-runner --concurrency 1 --playwright --browsers firefox",
    "test:webkit": "web-test-runner --playwright --browsers webkit",
    "test:all": "web-test-runner --concurrency 1 --playwright --browsers chromium firefox webkit",
    "test:node": "node --test 'test-node/**/*.test.js'",
    "conformance:generate": "node scripts/conformance.mjs generate",
    "conformance:check": "node scripts/conformance.mjs check",
    "test:ci": "npm run test:node && npm run conformance:check && npm run test:all -- --fail-only && node test/lib/ensure-full-coverage.cjs",
    "test:coverage": "npm run test:chrome && node test/lib/ensure-full-coverage.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panphora/hyper-html-api.git"
  },
  "dependencies": {
    "hyper-morph": "^1.7.0"
  },
  "devDependencies": {
    "@panphora/clayjs": "^1.24.0",
    "@web/test-runner": "^0.20.0",
    "@web/test-runner-playwright": "^0.11.0",
    "chai": "^4.3.6",
    "chai-dom": "^1.11.0",
    "cheerio": "1.2.0",
    "esbuild": "^0.24.0",
    "http-server": "^14.1.1",
    "jsdom": "^29.0.2",
    "lcov-parse": "^1.0.0",
    "mocha": "^11.0.1",
    "prettier": "^3.4.2",
    "sinon": "^9.2.4"
  },
  "hyper": {
    "kind": "lib",
    "status": "active",
    "url": "https://github.com/panphora/hyper-html-api"
  }
}
